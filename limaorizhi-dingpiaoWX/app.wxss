/* 全局样式 */
view, text, scroll-view, swiper, input, image {
  box-sizing: border-box;
}

/* 全局按钮重置：消除微信原生 button 默认样式导致的偏移 */
button {
  padding: 0;
  margin: 0;
  min-width: 0;
  line-height: normal;
  box-sizing: border-box;
}
button::after {
  border: none;
}

page {
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif;
  font-size: 14px;
  color: #1a1a1a;
  background: #f5f6f8;
}
/**app.wxss**/
.container {
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: space-between;
  padding: 200rpx 0;
  box-sizing: border-box;
} 

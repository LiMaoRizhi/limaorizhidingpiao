page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f8;
}

.agreement-page {
  flex: 1;
  display: flex;
  flex-direction: column;
  min-height: 0;
  overflow: hidden;
  background: #f5f6f8;
}

.agreement-scroll {
  flex: 1;
  height: 0;
}

.agreement-content {
  padding: 20px 24px 40px;
  background: #fff;
  box-sizing: border-box;
}

.agreement-content text {
  font-size: 15px;
  line-height: 1.8;
  color: #333;
  white-space: pre-wrap;
  word-break: break-all;
}

.loading-box,
.empty-box {
  display: flex;
  justify-content: center;
  align-items: center;
  padding: 80px 0;
  color: #999;
  font-size: 14px;
}

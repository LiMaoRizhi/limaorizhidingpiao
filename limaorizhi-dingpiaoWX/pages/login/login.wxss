.login-page {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80px 32px 0;
  background: #f5f6f8;
  min-height: 100vh;
}

.login-logo {
  font-size: 28px;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8px;
}

.login-subtitle {
  font-size: 15px;
  color: #999;
  margin-bottom: 40px;
}

.login-btn {
  width: 100% !important;
  height: 50px;
  margin: 0;
  padding: 0;
  background: #1a1a1a;
  color: #fff;
  font-size: 17px;
  font-weight: 500;
  border-radius: 25px;
  border: none;
  line-height: 50px;
  text-align: center;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
}

.login-btn::after {
  border: none;
}

.login-btn-disabled {
  background: #e8e8e8;
  color: #aaa;
  border: none;
}

.login-tips {
  margin-bottom: 20px;
  text-align: center;
}

.agreement-row {
  display: flex;
  align-items: center;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2px;
}

/* 圆形勾选框：没勾是空心灰圈，勾了是黑底白对勾，一眼就懂 */
.checkbox {
  width: 32px;
  height: 32px;
  border: 1.5px solid #999;
  border-radius: 50%;
  flex-shrink: 0;
  margin-right: 6px;
  transition: all 0.2s;
  background: transparent;
  position: relative;
  box-sizing: border-box;
}

.checkbox.checked {
  background: #000;
  border-color: #000;
}

/* 白对勾：用旋转45度的L形边框画出来，比贴图干净 */
.checkbox.checked::after {
  content: '';
  position: absolute;
  left: 9px;
  top: 5px;
  width: 10px;
  height: 16px;
  border: solid #fff;
  border-width: 0 2.5px 2.5px 0;
  transform: rotate(45deg);
}

.agreement-text {
  color: #999;
  font-size: 12px;
}

.agreement-link {
  color: #000;
  font-size: 12px;
  font-weight: 500;
}

.login-hint {
  margin-top: 8px;
  font-size: 11px;
  color: #bbb;
}

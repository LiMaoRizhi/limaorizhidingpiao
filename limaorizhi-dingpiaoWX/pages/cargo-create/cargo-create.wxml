<!--货物托运下单-->
<navigation-bar title="新建托运" back="{{true}}"></navigation-bar>

<view class="create-page">
  <!-- 站点筛选（出发站/到达站） -->
  <view class="station-filter">
    <view class="station-box" bindtap="showFromPicker" hover-class="station-box-hover" hover-stay-time="80">
      <text class="station-label">出发站</text>
      <text class="station-name {{selectedFromStation ? 'station-name-active' : ''}}">{{selectedFromStation ? selectedFromStation.name : '全部地区'}}</text>
    </view>
    <view class="swap-btn" bindtap="swapStations" hover-class="station-box-hover" hover-stay-time="80">
      <image class="swap-icon" src="/images/icons/route-direction.svg" />
    </view>
    <view class="station-box" bindtap="showToPicker" hover-class="station-box-hover" hover-stay-time="80">
      <text class="station-label">到达站</text>
      <text class="station-name {{selectedToStation ? 'station-name-active' : ''}}">{{selectedToStation ? selectedToStation.name : '全部地区'}}</text>
    </view>
  </view>

  <!-- 日期选择 + 清除筛选 -->
  <view class="date-bar">
    <text class="date-bar-label">托运日期</text>
    <picker mode="date" value="{{tripDate}}" start="{{today}}" bindchange="onDateChange">
      <text class="date-bar-value">{{tripDate}}</text>
    </picker>
    <view class="clear-filter-btn" bindtap="clearFilter" wx:if="{{selectedFromStation || selectedToStation}}">
      <image class="btn-bg-img" src="/images/icons/water-bg.jpg" mode="aspectFill" />
      <view class="water-flow-layer"></view>
      <image class="clear-filter-icon" src="/images/icons/clear-filter.svg" />
      <text class="clear-filter-text">清除筛选</text>
    </view>
  </view>

  <!-- 班次选择列表（未选班次时展示） -->
  <view class="trip-list" wx:if="{{tripList.length > 0 && !selectedTrip}}">
    <view class="trip-list-title">请选择班次</view>
    <view class="trip-list-item" wx:for="{{tripList}}" wx:key="id" bindtap="selectTrip" data-trip="{{item}}" hover-class="trip-list-item-hover" hover-stay-time="80">
      <view class="trip-item-route">
        <text class="trip-item-from">{{item.fromName}}</text>
        <text class="trip-item-arrow">→</text>
        <text class="trip-item-to">{{item.toName}}</text>
      </view>
      <view class="trip-item-info">
        <text class="trip-item-time">{{item.departure_time}}发车</text>
        <text class="trip-item-arrival" wx:if="{{item.arrival_text}}">{{item.arrival_text}}到</text>
        <text class="trip-item-plate" wx:if="{{item.vehicle}}">{{item.vehicle.plate_no}}</text>
        <text class="trip-item-seats {{item.available_seats <= 0 ? 'trip-item-warn' : ''}}">余{{item.available_seats}}座</text>
      </view>
    </view>
  </view>

  <!-- 无班次提示 -->
  <view class="no-trip-tip" wx:if="{{tripList.length === 0}}">
    <text>当前日期暂无可托运班次，请更换日期或站点</text>
  </view>

  <!-- 已选班次信息（含更换按钮） -->
  <view class="trip-card" wx:if="{{selectedTrip}}">
    <view class="trip-card-route">
      <text class="trip-card-from">{{selectedTrip.fromName}}</text>
      <text class="trip-card-arrow">→</text>
      <text class="trip-card-to">{{selectedTrip.toName}}</text>
      <text class="trip-card-change" bindtap="backToSelectTrip">更换</text>
    </view>
    <view class="trip-card-info">
      <view class="trip-info-item">
        <text class="trip-info-label">发车</text>
        <text class="trip-info-value">{{selectedTrip.departure_time}}</text>
      </view>
      <view class="trip-info-item" wx:if="{{selectedTrip.arrival_text}}">
        <text class="trip-info-label">到达</text>
        <text class="trip-info-value">{{selectedTrip.arrival_text}}</text>
      </view>
      <view class="trip-info-item" wx:if="{{selectedTrip.vehicle}}">
        <text class="trip-info-label">车牌</text>
        <text class="trip-info-value">{{selectedTrip.vehicle.plate_no}}</text>
      </view>
      <view class="trip-info-item">
        <text class="trip-info-label">余票</text>
        <text class="trip-info-value {{selectedTrip.available_seats <= 0 ? 'trip-info-warn' : ''}}">{{selectedTrip.available_seats}}座</text>
      </view>
    </view>
  </view>

  <!-- 托运信息 -->
  <view class="section" wx:if="{{selectedTrip}}">
    <view class="section-title">托运信息</view>

    <view class="form-group">
      <text class="form-label">寄件人</text>
      <input class="form-input {{focusedField === 'senderName' ? 'form-input--focus' : ''}}" placeholder="寄件人姓名" value="{{senderName}}" bindinput="onSenderNameInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="senderName" always-embed="{{true}}" />
    </view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input {{focusedField === 'senderPhone' ? 'form-input--focus' : ''}}" type="number" maxlength="11" placeholder="寄件人手机号" value="{{senderPhone}}" bindinput="onSenderPhoneInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="senderPhone" always-embed="{{true}}" />
    </view>

    <view class="form-group">
      <text class="form-label">收件人</text>
      <input class="form-input {{focusedField === 'receiverName' ? 'form-input--focus' : ''}}" placeholder="收件人姓名" value="{{receiverName}}" bindinput="onReceiverNameInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="receiverName" always-embed="{{true}}" />
    </view>
    <view class="form-group">
      <text class="form-label">手机号</text>
      <input class="form-input {{focusedField === 'receiverPhone' ? 'form-input--focus' : ''}}" type="number" maxlength="11" placeholder="收件人手机号" value="{{receiverPhone}}" bindinput="onReceiverPhoneInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="receiverPhone" always-embed="{{true}}" />
    </view>

    <view class="form-group">
      <text class="form-label">货物类型</text>
      <picker mode="selector" range="{{cargoTypes}}" bindchange="onCargoTypeChange">
        <view class="form-picker">
          <text class="picker-text">{{cargoType}}</text>
          <text class="picker-arrow">›</text>
        </view>
      </picker>
    </view>

    <view class="form-group">
      <text class="form-label">重量(kg)</text>
      <input class="form-input {{focusedField === 'weight' ? 'form-input--focus' : ''}}" type="digit" placeholder="0.1~50kg" value="{{weight}}" bindinput="onWeightInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="weight" always-embed="{{true}}" />
    </view>

    <view class="form-group form-group--textarea">
      <text class="form-label">备注</text>
      <textarea class="form-textarea {{focusedField === 'description' ? 'form-textarea--focus' : ''}}" placeholder="货物描述（选填）" value="{{description}}" bindinput="onDescInput" bindfocus="onFieldFocus" bindblur="onFieldBlur" data-field="description" always-embed="{{true}}" />
    </view>
  </view>

  <!-- 运费预估 -->
  <view class="fee-section" wx:if="{{feePreview}}">
    <view class="fee-row">
      <text class="fee-label">里程</text>
      <text class="fee-value">{{feePreview.distance_km}}km</text>
    </view>
    <view class="fee-row">
      <text class="fee-label">基础运费</text>
      <text class="fee-value">¥{{feePreview.base_fee}}</text>
    </view>
    <view class="fee-row" wx:if="{{feePreview.weight_fee > 0}}">
      <text class="fee-label">超重运费</text>
      <text class="fee-value">¥{{feePreview.weight_fee}}</text>
    </view>
    <view class="fee-row total">
      <text class="fee-label">合计运费</text>
      <text class="fee-value total-value">¥{{feePreview.fee}}</text>
    </view>
  </view>

  <!-- 提交按钮 -->
  <view class="submit-area" wx:if="{{selectedTrip}}">
    <button class="submit-btn" bindtap="handleSubmit" disabled="{{submitting}}">
      {{submitting ? '提交中...' : '确认下单'}}
    </button>
  </view>
</view>

<!-- 站点筛选弹窗（支持搜索） -->
<view class="modal-mask" id="stationMask" wx:if="{{showStationPicker}}" bindtap="onStationMaskTap" catchtouchmove="noop">
  <view class="station-modal" catchtap="noop">
    <view class="modal-header">
      <text class="modal-title-text">{{stationPickerType === 'from' ? '选择出发站' : '选择到达站'}}</text>
      <view class="modal-close" catchtap="closeStationPicker">×</view>
    </view>
    <view class="station-search-box {{stationSearchFocused ? 'station-search-box-focus' : ''}}">
      <image class="station-search-icon" src="/images/icons/search.svg" />
      <input class="station-search-input" placeholder="中文 / 拼音 / 首字母" value="{{stationSearchValue}}" bindinput="onStationSearch" bindfocus="onStationSearchFocus" bindblur="onStationSearchBlur" bindconfirm="onStationSearchConfirm" adjust-position="{{false}}" always-embed="{{true}}" cursor-spacing="20" confirm-type="search" />
      <text class="station-search-clear" wx:if="{{stationSearchValue}}" catchtap="clearStationSearch">×</text>
    </view>
    <scroll-view scroll-y class="station-scroll">
      <view class="station-item" bindtap="onStationTap" data-station="{{item}}" wx:for="{{filteredStations}}" wx:key="id">
        <text>{{item.name}}</text>
      </view>
      <view class="station-empty" wx:if="{{filteredStations.length === 0}}">未找到匹配站点</view>
    </scroll-view>
  </view>
</view>


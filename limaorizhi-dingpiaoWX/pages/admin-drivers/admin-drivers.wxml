<!--管理后台 - 司机管理-->
<navigation-bar title="司机管理" back="{{true}}" background="#ffffff" color="#000000"></navigation-bar>

<view class="page">
  <!-- 非超管提示 -->
  <view class="permission-tip" wx:if="{{!isSuperAdmin}}">
    <text class="perm-icon">⚠</text>
    <text class="perm-text">司机管理仅超级管理员可查看</text>
  </view>

  <block wx:if="{{isSuperAdmin}}">
    <view class="filter-bar">
      <view class="search-row">
        <view class="search-box {{inputFocused === 'search' ? 'focused' : ''}}">
          <image class="search-icon" src="/images/icons/search.svg" mode="aspectFit"></image>
          <input class="search-input" type="text" placeholder="姓名 / 手机号" value="{{keyword}}" data-field="search" confirm-type="search" bindinput="onKeywordInput" bindconfirm="onSearchConfirm" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
          <view class="search-clear" wx:if="{{keyword}}" bindtap="onClearKeyword">×</view>
        </view>
        <view class="add-btn" wx:if="{{isSuperAdmin}}" bindtap="openAdd">+ 新增</view>
      </view>
      <scroll-view class="tab-scroll" scroll-x enable-flex>
        <view class="tab-item {{activeStatus === item.key ? 'active' : ''}}" wx:for="{{statusTabs}}" wx:key="key" data-key="{{item.key}}" bindtap="onStatusTab">{{item.text}}</view>
      </scroll-view>
    </view>

    <scroll-view class="list-scroll" scroll-y enable-back-to-top refresher-enabled bindrefresherrefresh="onPullDownRefresh" refresher-triggered="{{loading}}" bindscrolltolower="onLoadMore">
      <view class="list-wrap">
        <view class="total-tip" wx:if="{{!loading && list.length > 0}}">共 {{total}} 位司机</view>

        <view class="driver-card" wx:for="{{list}}" wx:key="id">
          <view class="card-top">
            <view class="driver-info">
              <view class="driver-name-row">
                <text class="driver-name">{{item.name}}</text>
                <text class="status-tag status-{{item.statusCls}}">{{item.statusText}}</text>
              </view>
              <text class="driver-meta" wx:if="{{item.employee_no}}">工号：{{item.employee_no}}</text>
              <text class="driver-meta" wx:if="{{item.license_no}}">驾驶证：{{item.license_no}}</text>
            </view>
          </view>
          <view class="card-bottom">
            <view class="contact-block">
              <text class="driver-phone">{{item.phone}}</text>
              <text class="driver-login">最近登录：{{item.last_login}}</text>
            </view>
            <view class="call-btn" data-phone="{{item.phone}}" catchtap="onCallDriver">拨打</view>
          </view>
          <view class="card-actions" wx:if="{{isSuperAdmin}}">
            <view class="act-btn edit" data-id="{{item.id}}" bindtap="openEdit">编辑</view>
            <view class="act-btn {{item.status === 1 ? 'warn' : 'primary'}}" data-id="{{item.id}}" bindtap="onToggleStatus">{{item.status === 1 ? '禁用' : '启用'}}</view>
            <view class="act-btn delete" data-id="{{item.id}}" bindtap="onDelete">删除</view>
          </view>
        </view>

        <view class="loading" wx:if="{{loading && list.length === 0}}">加载中...</view>
        <view class="empty" wx:if="{{!loading && list.length === 0}}"><text>暂无司机</text></view>
        <view class="loading-more" wx:if="{{loadingMore}}">加载中...</view>
        <view class="no-more" wx:if="{{!loading && !loadingMore && list.length > 0 && !hasMore}}">没有更多了</view>
      </view>
    </scroll-view>
  </block>
</view>

<!-- 新增 / 编辑 弹层 -->
<view class="mask {{formVisible ? 'show' : ''}}" bindtap="closeForm">
  <view class="form-sheet {{formVisible ? 'show' : ''}}" catchtap="preventBubble">
    <view class="sheet-handle"></view>
    <view class="sheet-title">{{formMode === 'edit' ? '编辑司机' : '新增司机'}}</view>

    <view class="form-body">
      <view class="form-item">
        <text class="form-label">姓名<text class="req">*</text></text>
        <input class="form-input {{inputFocused === 'name' ? 'focused' : ''}}" type="text" placeholder="请输入司机姓名" value="{{form.name}}" data-field="name" bindinput="onFormInput" maxlength="20" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
      </view>
      <view class="form-item">
        <text class="form-label">手机号<text class="req">*</text></text>
        <input class="form-input {{inputFocused === 'phone' ? 'focused' : ''}}" type="number" placeholder="11位手机号（司机登录账号）" value="{{form.phone}}" data-field="phone" bindinput="onFormInput" maxlength="11" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
      </view>
      <view class="form-item">
        <text class="form-label">密码{{formMode === 'edit' ? '' : ' *'}}</text>
        <input class="form-input {{inputFocused === 'password' ? 'focused' : ''}}" type="text" password placeholder="{{formMode === 'edit' ? '留空不修改（≥8位含字母和数字）' : '≥8位，需同时含字母和数字'}}" value="{{form.password}}" data-field="password" bindinput="onFormInput" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
      </view>
      <view class="form-item">
        <text class="form-label">工号</text>
        <input class="form-input {{inputFocused === 'employee_no' ? 'focused' : ''}}" type="text" placeholder="选填，用于区分重名司机" value="{{form.employee_no}}" data-field="employee_no" bindinput="onFormInput" maxlength="30" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
      </view>
      <view class="form-item">
        <text class="form-label">驾驶证号</text>
        <input class="form-input {{inputFocused === 'license_no' ? 'focused' : ''}}" type="text" placeholder="选填" value="{{form.license_no}}" data-field="license_no" bindinput="onFormInput" maxlength="30" bindfocus="onFieldFocus" bindblur="onFieldBlur"></input>
      </view>
      <view class="form-item form-item-switch" wx:if="{{formMode === 'edit'}}">
        <text class="form-label">状态</text>
        <view class="switch-wrap">
          <text class="switch-text {{form.status === 1 ? 'on' : ''}}">{{form.status === 1 ? '启用' : '禁用'}}</text>
          <switch checked="{{form.status === 1}}" bindchange="onStatusChange" color="#1a1a1a"></switch>
        </view>
      </view>
      <view class="form-tip" wx:if="{{formMode === 'add'}}">新增司机默认为「启用」状态</view>
    </view>

    <view class="form-actions">
      <view class="form-btn ghost {{submitting ? 'disabled' : ''}}" bindtap="closeForm">取消</view>
      <view class="form-btn primary {{submitting ? 'disabled' : ''}}" bindtap="onSave">{{submitting ? '保存中...' : '保存'}}</view>
    </view>
  </view>
</view>

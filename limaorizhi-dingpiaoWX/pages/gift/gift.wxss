.gift-page {
  min-height: 100vh;
  background: #f5f6f8;
  padding-bottom: 30px;
}

/* 主标签栏 */
.main-tabs {
  display: flex;
  flex-direction: row;
  background: #fff;
  height: 48px;
  border-bottom: 1px solid #f0f0f0;
}
.main-tab {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #666;
  position: relative;
}
.main-tab.active {
  color: #1296db;
  font-weight: 600;
}
.main-tab.active::after {
  content: '';
  position: absolute;
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
  width: 30px;
  height: 3px;
  background: #1296db;
  border-radius: 2px;
}

/* 优惠券子标签 */
.sub-tabs {
  display: flex;
  flex-direction: row;
  padding: 0 16px;
  height: 40px;
  align-items: center;
  gap: 20px;
}
.sub-tab {
  font-size: 14px;
  color: #999;
  padding: 4px 0;
  position: relative;
}
.sub-tab.active {
  color: #1296db;
  font-weight: 600;
}
.sub-tab.active::after {
  content: '';
  position: absolute;
  bottom: -2px;
  left: 0;
  right: 0;
  height: 2px;
  background: #1296db;
  border-radius: 1px;
}

/* 优惠券列表 */
.coupon-list {
  padding: 0 12px;
}
.coupon-item {
  display: flex;
  flex-direction: row;
  align-items: stretch;
  height: 100px;
  margin-bottom: 12px;
  border-radius: 10px;
  overflow: hidden;
  background: #fff;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.06);
  position: relative;
}
.coupon-left {
  width: 110px;
  background: linear-gradient(135deg, #1296db, #0d7fb8);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}
.coupon-value {
  font-size: 22px;
  font-weight: bold;
  color: #fff;
}
.coupon-desc {
  font-size: 10px;
  color: rgba(255, 255, 255, 0.9);
  margin-top: 4px;
  text-align: center;
}
.coupon-right {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
  padding: 0 56px 0 16px;
  overflow: hidden;
}
.coupon-label {
  font-size: 11px;
  color: #1296db;
  font-weight: 500;
}
.coupon-name {
  font-size: 15px;
  color: #333;
  margin-top: 4px;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.coupon-expire {
  font-size: 11px;
  color: #999;
  margin-top: 6px;
}

/* 优惠券状态标签 */
.coupon-status {
  position: absolute;
  top: 8px;
  right: 8px;
  padding: 2px 8px;
  border-radius: 10px;
  font-size: 10px;
  font-weight: 500;
}
.coupon-status.usable {
  background: rgba(18, 150, 219, 0.1);
  color: #1296db;
}
.coupon-status.used {
  background: rgba(153, 153, 153, 0.1);
  color: #999;
}
.coupon-status.expired {
  background: rgba(153, 153, 153, 0.1);
  color: #999;
}

/* 已使用/已过期优惠券变灰 */
.coupon-item .used ~ .coupon-left,
.coupon-item .expired ~ .coupon-left {
  background: linear-gradient(135deg, #bbb, #999);
}

/* 积分卡片 */
.points-card {
  display: flex;
  align-items: center;
  margin: 14px 12px;
  padding: 24px 20px;
  background: linear-gradient(135deg, #1296db, #0d7fb8);
  border-radius: 16px;
}
.gift-icon {
  width: 52px;
  height: 52px;
  flex-shrink: 0;
  margin-right: 18px;
}
.points-info {
  display: flex;
  flex-direction: column;
}
.points-label {
  font-size: 14px;
  color: rgba(255, 255, 255, 0.85);
}
.points-value {
  font-size: 36px;
  font-weight: bold;
  color: #fff;
  line-height: 1.2;
  margin: 2px 0;
}
.points-desc {
  font-size: 12px;
  color: rgba(255, 255, 255, 0.7);
}

/* 通用 section */
.section {
  margin: 12px;
  background: #fff;
  border-radius: 12px;
  overflow: hidden;
}
.section-header {
  padding: 16px 18px 8px;
}
.section-title {
  font-size: 16px;
  font-weight: 600;
  color: #1a1a1a;
}

/* 积分明细 */
.record-list {
  padding: 4px 18px 16px;
}
.record-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 12px 0;
  border-bottom: 0.5px solid #f0f0f0;
}
.record-item:last-child {
  border-bottom: none;
}
.record-left {
  display: flex;
  flex-direction: column;
  flex: 1;
}
.record-remark {
  font-size: 14px;
  color: #333;
}
.record-date {
  font-size: 12px;
  color: #999;
  margin-top: 4px;
}
.record-points {
  font-size: 16px;
  font-weight: 600;
}
.record-points.plus { color: #34c759; }
.record-points.minus { color: #ff3b30; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 60px 0 40px;
}
.empty-icon {
  width: 64px;
  height: 64px;
  opacity: 0.3;
}
.empty-text {
  font-size: 15px;
  color: #999;
  margin-top: 16px;
}
.empty-btn {
  margin-top: 16px;
  padding: 8px 28px;
  background: #1296db;
  color: #fff;
  font-size: 14px;
  border-radius: 20px;
}

/* 积分说明 */
.points-tips {
  margin: 12px;
  padding: 16px 18px;
  background: #fff;
  border-radius: 12px;
}
.tips-title {
  display: block;
  font-size: 14px;
  font-weight: 600;
  color: #666;
  margin-bottom: 8px;
}
.tips-text {
  display: block;
  font-size: 13px;
  color: #999;
  line-height: 1.8;
}

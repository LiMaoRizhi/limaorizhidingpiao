.verify-page {
  min-height: 100vh;
  background: #f5f6f8;
}

/* 登录区域 */
.login-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 80rpx 40rpx;
}
.login-logo {
  font-size: 40rpx;
  font-weight: bold;
  color: #1a1a1a;
  margin-bottom: 8rpx;
}
.login-subtitle {
  font-size: 28rpx;
  color: #8c8c8c;
  margin-bottom: 60rpx;
}
.form-item {
  width: 100%;
  margin-bottom: 24rpx;
}
.input {
  width: 100%;
  height: 88rpx;
  background: #fff;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  border: 2rpx solid #1a1a1a;
  transition: border-color 0.2s ease;
}

.input--focus {
  border-color: #1e6fff;
}
.login-btn {
  width: 100%;
  height: 88rpx;
  line-height: 88rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 32rpx;
  margin-top: 16rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 班次列表 */
.trip-list {
  padding: 20rpx;
}
.header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  padding: 20rpx;
}
.header-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  padding: 10rpx 28rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 40rpx;
  background: transparent;
}
.header-name {
  font-size: 30rpx;
  font-weight: 500;
  color: #1a1a1a;
  padding: 10rpx 28rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 40rpx;
  background: transparent;
}

.empty {
  text-align: center;
  padding: 120rpx 0;
  color: #8c8c8c;
  font-size: 30rpx;
}

.trip-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 28rpx;
  margin-bottom: 20rpx;
}
.trip-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 12rpx;
}
.trip-no {
  font-size: 30rpx;
  font-weight: bold;
  color: #1a1a1a;
}
.trip-date {
  font-size: 26rpx;
  color: #8c8c8c;
}
.trip-route {
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 32rpx;
  color: #1a1a1a;
  margin-bottom: 12rpx;
}
.trip-route-text {
  flex: 1;
}
.trip-info {
  display: flex;
  gap: 30rpx;
  font-size: 26rpx;
  color: #595959;
  margin-bottom: 20rpx;
}
.scan-btn {
  width: auto;
  min-width: auto;
  height: 88rpx;
  padding: 0 30rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 28rpx;
  font-weight: 500;
  display: flex; align-items: center; justify-content: center; gap: 8rpx;
  flex-shrink: 0;
  line-height: normal;
  margin: 0;
}
.trip-actions-sub {
  display: flex;
  gap: 40rpx;
  padding-top: 20rpx;
  border-top: 1rpx solid #f0f0f0;
}
.manual-btn {
  width: 220rpx;
  min-width: auto;
  height: 72rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  line-height: normal;
  margin: 0;
}
.track-start-btn {
  width: 220rpx;
  min-width: auto;
  height: 72rpx;
  background: #1296db;
  color: #fff;
  border-radius: 12rpx;
  font-size: 26rpx;
  display: flex; align-items: center; justify-content: center; gap: 6rpx;
  line-height: normal;
  margin: 0;
}
.btn-icon {
  width: 36rpx;
  height: 36rpx;
}

/* 弹窗 */
.modal-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.5);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 999;
}
.modal-content {
  width: 600rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx;
}
.modal-title {
  font-size: 32rpx;
  font-weight: bold;
  text-align: center;
  margin-bottom: 30rpx;
  color: #1a1a1a;
}
.modal-input {
  width: 100%;
  height: 80rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 10rpx;
  padding: 0 20rpx;
  font-size: 30rpx;
  box-sizing: border-box;
  margin-bottom: 30rpx;
}
.modal-actions {
  display: flex;
  gap: 24rpx;
}
.modal-cancel {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #f5f5f5;
  color: #595959;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}
.modal-confirm {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  background: #1a1a1a;
  color: #fff;
  border-radius: 12rpx;
  font-size: 30rpx;
  display: flex; align-items: center; justify-content: center;
}

/* 核销结果 */
.result-content {
  text-align: center;
}
.result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}
.result-icon.success { color: #52c41a; }
.result-icon.fail { color: #ff4d4f; }
.result-title {
  font-size: 34rpx;
  font-weight: bold;
  margin-bottom: 30rpx;
  color: #1a1a1a;
}
.result-detail {
  text-align: left;
  margin-bottom: 30rpx;
}
.result-row {
  display: flex;
  justify-content: space-between;
  padding: 12rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 28rpx;
  color: #595959;
}

/* header退出按钮 */
.header-logout {
  margin-left: auto;
  display: flex;
  align-items: center;
  gap: 6rpx;
  padding: 10rpx 24rpx;
  border: 2rpx solid #d81e06;
  border-radius: 40rpx;
  font-size: 26rpx;
  color: #d81e06;
  background: transparent;
}
.logout-icon {
  width: 30rpx;
  height: 30rpx;
}

/* 乘客名单弹窗 */
.passenger-content {
  width: 640rpx;
}
.passenger-scroll {
  max-height: 600rpx;
}
.passenger-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.passenger-left {
  display: flex;
  align-items: center;
  gap: 12rpx;
}
.passenger-name {
  font-size: 30rpx;
  color: #1a1a1a;
}
.passenger-seat {
  font-size: 26rpx;
  color: #8c8c8c;
}
.passenger-check {
  font-size: 28rpx;
}
.passenger-check.is-checked {
  color: #52c41a;
}
.passenger-check.not-checked {
  color: #bfbfbf;
}
.passenger-phone-area {
  display: flex;
  align-items: center;
  gap: 8rpx;
}
.passenger-phone {
  font-size: 28rpx;
  color: #007aff;
}
.call-icon {
  font-size: 24rpx;
  color: #fff;
  background: #007aff;
  padding: 4rpx 16rpx;
  border-radius: 8rpx;
}
.passenger-empty {
  text-align: center;
  padding: 60rpx 0;
  color: #8c8c8c;
  font-size: 28rpx;
}

page { background: #f5f6f8; }

.scrollarea { height: 100vh; }
.page-content { padding: 16px; }

.form-item {
  display: flex; flex-direction: column; margin-bottom: 16px;
}

.form-label { font-size: 14px; color: #1a1a1a; margin-bottom: 8px; font-weight: 500; }

.form-input {
  background: #fff; border-radius: 8px; padding: 10px 14px;
  font-size: 15px; color: #333; height: 44px; box-sizing: border-box;
  border: 1.5px solid #1a1a1a;
  transition: border-color 0.2s ease;
}

.form-input--focus {
  border-color: #1e6fff;
}

.save-btn {
  width: 100%; height: 50px; background: #1a1a1a; color: #fff;
  font-size: 16px; font-weight: 500; border-radius: 25px; border: none; margin-top: 20px;
  display: flex; align-items: center; justify-content: center;
}
.save-btn::after { border: none; }

/* 改签页样式 */
.page-content {
  padding: 24rpx 32rpx calc(48rpx + env(safe-area-inset-bottom));
  background: #f5f6f8;
  min-height: 100vh;
}

/* 改签引导横幅：一眼看出正在改签 */
.change-banner {
  background: #1296db;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.change-banner-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #fff;
}
.change-banner-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.9);
}

/* 原班次信息卡片 */
.origin-card {
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
  margin-bottom: 24rpx;
}
.origin-header {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.origin-label {
  font-size: 26rpx;
  color: #999;
}
.origin-no {
  font-size: 24rpx;
  color: #666;
}
.origin-standing {
  font-size: 20rpx;
  color: #fff;
  background: #ff9500;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.origin-route {
  display: flex;
  align-items: center;
  gap: 16rpx;
}
.origin-station {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
}
.origin-arrow {
  width: 36rpx;
  height: 36rpx;
}
.origin-meta {
  display: flex;
  align-items: center;
  gap: 16rpx;
  margin-top: 16rpx;
}
.origin-time {
  font-size: 26rpx;
  color: #666;
}
.origin-count {
  font-size: 24rpx;
  color: #999;
}

/* 日期选择行 */
.date-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  background: #fff;
  border-radius: 20rpx;
  padding: 24rpx 32rpx;
  margin-bottom: 24rpx;
}
.date-label {
  font-size: 28rpx;
  color: #1a1a1a;
  font-weight: 500;
}
.date-picker {
  display: flex;
  align-items: center;
  gap: 8rpx;
  font-size: 28rpx;
  color: #1296db;
  font-weight: 500;
}
.date-arrow {
  font-size: 24rpx;
}

/* 班次列表 */
.trip-list {
  display: flex;
  flex-direction: column;
  gap: 20rpx;
}
.trip-card {
  display: flex;
  align-items: center;
  background: #fff;
  border-radius: 20rpx;
  padding: 28rpx 32rpx;
}
.trip-disabled {
  opacity: 0.55;
}
.trip-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  min-width: 140rpx;
}
.trip-time {
  font-size: 40rpx;
  font-weight: 700;
  color: #1a1a1a;
}
.trip-date {
  font-size: 22rpx;
  color: #999;
  margin-top: 4rpx;
}
.trip-mid {
  flex: 1;
  margin-left: 24rpx;
  display: flex;
  flex-direction: column;
  gap: 6rpx;
}
.trip-no {
  font-size: 26rpx;
  color: #333;
}
.trip-arrive {
  font-size: 24rpx;
  color: #999;
}
.trip-tags {
  display: flex;
  align-items: center;
  gap: 12rpx;
  margin-top: 4rpx;
}
.trip-seats-tag {
  font-size: 22rpx;
  color: #1296db;
  background: #eef7fd;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.trip-seats-none {
  color: #bbb;
  background: #f5f5f5;
}
.trip-standing-tag {
  font-size: 22rpx;
  color: #ff9500;
  background: #fff8f0;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
}
.trip-right {
  display: flex;
  flex-direction: column;
  align-items: flex-end;
  margin-left: 16rpx;
}
.trip-price {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff3b30;
}
.trip-per {
  font-size: 20rpx;
  font-weight: 400;
  color: #999;
}
.trip-disabled-tip {
  font-size: 22rpx;
  color: #ff9500;
  margin-top: 8rpx;
}
/* 改签按钮：明确的点击入口 */
.trip-change-btn {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #fff;
  background: #1296db;
  border-radius: 28rpx;
  padding: 8rpx 28rpx;
}

/* 空状态 / 加载中 */
.empty {
  background: #fff;
  border-radius: 20rpx;
  padding: 80rpx 32rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 12rpx;
}
.empty-text {
  font-size: 28rpx;
  color: #666;
}
.empty-hint {
  font-size: 24rpx;
  color: #999;
}
.loading {
  padding: 80rpx 0;
  text-align: center;
  font-size: 26rpx;
  color: #999;
}

/* 改签说明 */
.change-tip {
  margin-top: 32rpx;
  font-size: 22rpx;
  color: #999;
  line-height: 1.6;
}

/* 确认弹窗 */
.modal-mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 100;
  display: flex;
  align-items: center;
  justify-content: center;
}
.confirm-modal {
  width: 620rpx;
  background: #fff;
  border-radius: 20rpx;
  padding: 40rpx 36rpx 32rpx;
  box-sizing: border-box;
}
.confirm-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #1a1a1a;
  text-align: center;
  margin-bottom: 28rpx;
}
.confirm-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1px solid #f0f0f0;
}
.confirm-label {
  font-size: 26rpx;
  color: #999;
}
.confirm-val {
  font-size: 26rpx;
  color: #1a1a1a;
  max-width: 400rpx;
  text-align: right;
}
.confirm-note {
  font-size: 22rpx;
  color: #ff9500;
  margin-top: 20rpx;
  line-height: 1.5;
}
.confirm-btns {
  display: flex;
  gap: 20rpx;
  margin-top: 32rpx;
}
.confirm-btn-cancel {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #666;
  background: #f5f5f5;
  border-radius: 40rpx;
}
.confirm-btn-ok {
  flex: 1;
  height: 80rpx;
  line-height: 80rpx;
  text-align: center;
  font-size: 28rpx;
  color: #fff;
  background: #1296db;
  border-radius: 40rpx;
}

page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f8;
}

.scrollarea {
  flex: 1;
  height: 0;
}

/* 用户信息卡片 */
.user-card {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin: 14px 16px;
  padding: 24px 20px;
  background: #fff;
  border-radius: 12px;
}

/* 头像容器（view 做圆形视觉） */
.avatar-wrapper {
  width: 64px;
  height: 64px;
  border-radius: 50%;
  background: transparent;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
  position: relative;
  overflow: hidden;
  box-sizing: border-box;
  border: 2px solid #fff;
  box-shadow: 0 2px 8px rgba(0,0,0,0.08);
}

.avatar-img {
  width: 40px;
  height: 40px;
}

/* 真实头像：绝对定位填满圆形容器，避免 flex 下 100% 高度塌陷 */
.avatar-img-real {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
}

/* 透明 button 覆盖层（只负责 chooseAvatar 交互） */
.avatar-overlay {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  opacity: 0;
  padding: 0;
  margin: 0;
  border: none;
  background: transparent;
  z-index: 1;
}

.avatar-overlay::after {
  border: none;
}

.user-info {
  flex: 1;
  margin-left: 16px;
  display: flex;
  flex-direction: column;
}

/* 昵称输入框 */
.user-name-input {
  font-size: 20px;
  font-weight: bold;
  color: #1a1a1a;
  height: 32px;
  line-height: 32px;
}

.user-phone {
  font-size: 15px;
  color: #999;
  margin-top: 6px;
}

.user-phone-row {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 6px;
}

.phone-eye-icon {
  width: 18px;
  height: 18px;
  margin-left: 6px;
}

/* 退出登录 */
.logout-section {
  margin: 20px 16px 30px;
  padding: 0 20px;
  background: #fff;
  border-radius: 12px;
}

.logout-btn {
  height: 50px;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  font-size: 16px;
  color: #1a1a1a;
}

.logout-icon {
  width: 20px;
  height: 20px;
  margin-right: 8px;
}

/* 注销账号链接 */
.delete-account-link {
  text-align: center;
  font-size: 13px;
  color: #999;
  padding: 12px 0 16px;
  border-top: 0.5px solid #f0f0f0;
}

<!--全部订单-->

<!-- 导航栏（固定在顶部，含返回按钮） -->
<navigation-bar title="全部订单" back="{{true}}" background="#ffffff"></navigation-bar>

<!-- 筛选标签栏（固定在导航栏下方） -->
<view class="fixed-tabs">
  <view
    class="header-tab {{activeTab === item.key ? 'active' : ''}}"
    wx:for="{{tabs}}"
    wx:key="key"
    data-key="{{item.key}}"
    bindtap="onTabChange"
  >
    <text>{{item.text}}</text>
    <view class="tab-line" wx:if="{{activeTab === item.key}}"></view>
  </view>
</view>

<!-- 可滚动内容区 -->
<scroll-view class="scrollarea" scroll-y bindscrolltolower="loadMore" lower-threshold="100">
  <view class="page-content">

    <!-- 未登录提示 -->
    <view class="empty-state" wx:if="{{!isLogin}}">
      <view class="login-prompt">
        <text class="empty-text">请先登录查看订单</text>
        <view class="login-btn" bindtap="goLogin">去登录</view>
      </view>
    </view>

    <!-- 订单列表（卡片结构完全对齐首页 route-card 三层布局） -->
    <view class="order-list" wx:if="{{isLogin && filteredOrders.length > 0}}">
      <view class="order-card" wx:for="{{filteredOrders}}" wx:key="id" bindtap="goToDetail" bindlongpress="onLongPressOrder" data-id="{{item.id}}" data-status="{{item.status}}">
        <!-- 第一层：路线 + 状态标签（对齐首页 route-top） -->
        <view class="order-top">
          <view class="order-path">
            <text class="order-from">{{item.from}}</text>
            <image class="order-nav-icon" src="/images/icons/route-direction.svg" />
            <text class="order-to">{{item.to}}</text>
          </view>
          <text class="order-status-tag status-{{item.status}}">{{item.statusText}}</text>
        </view>
        <!-- 第二层：行程信息（对齐首页 route-via 的分隔线风格） -->
        <view class="order-trip">
          <image class="order-bus-icon" src="/images/icons/bus.svg" />
          <text class="order-time">{{item.date}} {{item.time}} 发车</text>
          <text class="order-type-tag {{item.isCargo ? 'cargo' : 'ticket'}}">{{item.typeText}}</text>
          <text class="order-standing-tag" wx:if="{{item.standTicket}}">无座</text>
          <text class="order-seats">{{item.infoText}}</text>
        </view>
        <!-- 订单号（独立一行，不与金额/按钮挤在一起） -->
        <view class="order-no-row">
          <text class="order-no">订单号 {{item.orderNo}}</text>
        </view>
        <!-- 第三层：价格 + 操作按钮（一行排布，原紧凑尺寸） -->
        <view class="order-bottom">
          <text class="order-price">¥{{item.price}}</text>
          <view class="order-action-wrap">
            <view class="order-action-secondary" wx:if="{{item.changeAction}}" catchtap="onSecondaryAction" data-id="{{item.id}}" data-type="change" data-cargo="{{item.isCargo}}"><text>{{item.changeAction}}</text></view>
            <view class="order-action-secondary" wx:if="{{item.secondaryAction}}" catchtap="onSecondaryAction" data-id="{{item.id}}" data-type="{{item.secondaryActionType}}" data-cargo="{{item.isCargo}}"><text>{{item.secondaryAction}}</text></view>
            <view class="order-btn action-{{item.status}}" catchtap="onOrderAction" data-id="{{item.id}}" data-status="{{item.status}}"><text>{{item.actionText}}</text></view>
          </view>
        </view>
      </view>
    </view>

    <!-- 空状态：已登录但无订单 -->
    <view class="empty-state" wx:if="{{isLogin && filteredOrders.length === 0}}">
      <text class="empty-text">暂无订单</text>
    </view>

  </view>
</scroll-view>

<!-- 长按删除确认弹窗 -->
<view class="delete-mask" wx:if="{{showDeleteModal}}" bindtap="cancelDeleteOrder">
  <view class="delete-popup" catchtap="">
    <view class="delete-warning">确认删除？</view>
    <view class="delete-desc">删除后订单将不再显示，如需查看请联系客服。{{deleteTipExtra}}</view>
    <view class="delete-actions">
      <view class="delete-btn cancel-btn" bindtap="cancelDeleteOrder">取消</view>
      <view class="delete-btn confirm-btn" bindtap="confirmDeleteOrder">删除</view>
    </view>
  </view>
</view>



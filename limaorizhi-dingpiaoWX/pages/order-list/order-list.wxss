page {
  height: 100vh;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  background: #f5f6f8;
}

/* scroll-view 内容区（必须 flex:1 + height:0 才能正确固定头部） */
.scrollarea {
  flex: 1;
  height: 0;
}

.page-content {
  padding-bottom: calc(76px + env(safe-area-inset-bottom));
}

/* 筛选标签栏（固定在导航栏下方） */
.fixed-tabs {
  flex-shrink: 0;
  display: flex;
  flex-direction: row;
  padding: 0 16px;
  background: #ffffff;
}

.header-tab {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  height: 40px;
  position: relative;
}

.header-tab text {
  font-size: 14px;
  color: #8a8a8a;
}

.header-tab.active text {
  color: #1a1a1a;
  font-weight: 600;
}

.tab-line {
  position: absolute;
  bottom: 0;
  width: 24px;
  height: 3px;
  border-radius: 2px;
  background: #1296db;
}

/* 订单列表（间距与首页车票列表一致，保证卡片分隔层次感） */
.order-list {
  display: flex;
  flex-direction: column;
  gap: 12px;
  padding: 16px;
}

.order-card {
  background: #fff;
  border-radius: 12px;
  padding: 18px 20px;
  border: 1px solid #e0e0e0;
  box-shadow: 0 1px 4px rgba(0,0,0,0.05);
}

/* ===== 以下样式完全对齐首页 route-card 三层结构 ===== */

/* 第一层：路线 + 状态标签（对齐首页 route-top） */
.order-top {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 14px;
}

.order-path {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex: 1;
}

.order-from,
.order-to {
  font-size: 19px;
  font-weight: bold;
  color: #1a1a1a;
}

.order-nav-icon {
  width: 20px;
  height: 20px;
  margin: 0 10px;
}

.order-status-tag {
  display: inline-block;
  font-size: 12px;
  padding: 2px 10px;
  background: transparent;
  border: 1px solid #d0d0d0;
  border-radius: 12px;
  font-weight: 500;
  color: #1a1a1a;
}

/* 状态标签颜色（黑白蓝主题：待支付警示红，待出行/运输用蓝，已退款/取消用黑灰） */
.order-status-tag.status-0 { color: #ff3b30; border-color: rgba(255, 59, 48, 0.5); }
.order-status-tag.status-1 { color: #1296db; border-color: rgba(18, 150, 219, 0.5); }
.order-status-tag.status-2 { color: #8a8a8a; }
.order-status-tag.status-3 { color: #1a1a1a; border-color: rgba(26, 26, 26, 0.4); }
.order-status-tag.status-4 { color: #8a8a8a; }

/* 第二层：行程信息（对齐首页 route-via 的分隔线风格） */
.order-trip {
  display: flex;
  flex-direction: row;
  align-items: center;
  margin-top: 10px;
  padding-top: 10px;
  border-top: 1px solid #f5f5f5;
}

.order-bus-icon {
  width: 20px;
  height: 20px;
  margin-right: 8px;
  flex-shrink: 0;
}

.order-time {
  font-size: 16px;
  color: #333;
  font-weight: 500;
}

.order-type-tag {
  display: inline-block;
  font-size: 11px;
  color: #1a1a1a;
  padding: 1px 6px;
  background: transparent;
  border: 1px solid #d0d0d0;
  border-radius: 3px;
  font-weight: 500;
  margin-left: 8px;
  flex-shrink: 0;
}

/* 无座站票徽标（黑白配色） */
.order-standing-tag {
  display: inline-block;
  font-size: 11px;
  color: #fff;
  background: #1a1a1a;
  padding: 1px 6px;
  border-radius: 3px;
  font-weight: 500;
  margin-left: 6px;
  flex-shrink: 0;
}

.order-seats {
  font-size: 13px;
  color: #666;
  margin-left: 8px;
  flex-shrink: 0;
  white-space: nowrap;
}

/* 第三层：价格 + 操作按钮（一行规整排布，按钮过多时允许换行防止溢出卡片） */
.order-bottom {
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: space-between;
  margin-top: 10px;
  flex-wrap: wrap;
  row-gap: 10px;
}

/* 订单号独立行（不与金额/按钮挤在同一行，布局更规整） */
.order-no-row {
  margin-top: 8px;
  padding-top: 8px;
  border-top: 1px solid #f5f5f5;
}

.order-no {
  font-size: 12px;
  color: #999;
}

.order-action-wrap {
  display: flex;
  flex-direction: row;
  align-items: center;
  flex-shrink: 0;
  flex-wrap: wrap;
  row-gap: 8px;
  justify-content: flex-end;
  margin-left: auto;
}

.order-price {
  font-size: 22px;
  font-weight: bold;
  color: #1a1a1a;
  margin-right: 12px;
  flex-shrink: 0;
}

/* 操作按钮：紧凑胶囊，保持原尺寸 */
.order-action-secondary {
  padding: 8px 16px;
  border-radius: 22px;
  font-size: 13px;
  font-weight: 500;
  color: #1a1a1a;
  border: 1px solid #1a1a1a;
  margin-right: 8px;
  flex-shrink: 0;
  position: relative;
  z-index: 10;
}

/* 主操作按钮 */
.order-btn {
  background: #1a1a1a;
  color: #fff;
  font-size: 16px;
  font-weight: 500;
  padding: 8px 24px;
  border-radius: 22px;
  white-space: nowrap;
  flex-shrink: 0;
  box-shadow: 0 2px 8px rgba(0, 0, 0, 0.2);
  position: relative;
  z-index: 10;
}

.order-btn.action-0 { background: #1a1a1a; color: #fff; }
.order-btn.action-1 { background: #1a1a1a; color: #fff; }
.order-btn.action-2 { background: #1a1a1a; color: #fff; }
.order-btn.action-3 { background: transparent; color: #666; border: 1px solid #d0d0d0; box-shadow: none; }
.order-btn.action-4 { background: transparent; color: #666; border: 1px solid #d0d0d0; box-shadow: none; }

/* 空状态 */
.empty-state {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 80px 0;
}

.empty-text {
  font-size: 16px;
  color: #999;
}

.login-prompt {
  display: flex;
  flex-direction: column;
  align-items: center;
  gap: 16px;
}

.login-btn {
  background: #1a1a1a;
  color: #fff;
  font-size: 16px;
  padding: 10px 40px;
  border-radius: 22px;
}

/* 长按删除确认弹窗 */
.delete-mask {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0, 0, 0, 0.5);
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
}
.delete-popup {
  width: 280px;
  background: #fff;
  border-radius: 16px;
  overflow: hidden;
}
.delete-warning {
  text-align: center;
  font-size: 18px;
  font-weight: 600;
  color: #1a1a1a;
  margin-top: 28px;
}
.delete-desc {
  text-align: center;
  font-size: 14px;
  color: #999;
  line-height: 1.6;
  margin: 12px 24px 24px;
}
.delete-actions {
  display: flex;
  flex-direction: row;
  border-top: 0.5px solid #f0f0f0;
}
.delete-btn {
  flex: 1;
  text-align: center;
  font-size: 17px;
  padding: 14px 0;
}
.delete-btn.cancel-btn {
  color: #999;
  border-right: 0.5px solid #f0f0f0;
}
.delete-btn.cancel-btn:active {
  background: #f5f5f5;
}
.delete-btn.confirm-btn {
  color: #fff;
  background: #1a1a1a;
}
.delete-btn.confirm-btn:active {
  background: #333;
}

<!--我的-->
<navigation-bar back="{{false}}" background="rgba(255,255,255,0.5)"></navigation-bar>

<scroll-view class="scrollarea" scroll-y>
  <view class="page-content">

    <!-- 用户信息卡片（点击进入个人中心） -->
    <view class="user-card" bindtap="onUserTap">
      <view class="user-avatar">
        <image wx:if="{{userInfo.avatarUrl}}" class="avatar-img-real" src="{{userInfo.avatarUrl}}" mode="aspectFill" />
        <image wx:else class="avatar-img-real" src="/images/icons/default-avatar.svg" mode="aspectFill" />
      </view>
      <view class="user-info">
        <text class="user-name">{{userInfo.nickName}}</text>
        <view class="user-phone-row" wx:if="{{userInfo.isLogin}}">
          <text class="user-phone" wx:if="{{phoneMasked}}">{{maskedPhone}}</text>
          <text class="user-phone" wx:else>{{userInfo.phone}}</text>
          <image class="phone-eye-icon" src="{{phoneMasked ? '/images/icons/eye-close.svg' : '/images/icons/eye-open.svg'}}"></image>
        </view>
        <text class="user-phone" wx:else>{{userInfo.phone}}</text>
      </view>
      <view class="user-arrow">›</view>
    </view>

    <!-- 我的订单 -->
    <view class="order-section">
      <view class="order-header">
        <text class="order-title">我的订单</text>
        <text class="order-more" bindtap="onOrderTap">全部订单 ></text>
      </view>
      <view class="order-grid">
        <view class="order-item" wx:for="{{orderList}}" wx:key="name" data-status="{{item.status}}" bindtap="onOrderTap">
          <view class="order-icon-wrap">
            <image class="order-icon icon-{{item.cls}}" src="{{item.icon}}" style="transform: scale({{item.scale}})" />
            <view class="order-badge" wx:if="{{item.count > 0 && (item.status === '0' || item.status === '1')}}">{{item.count}}</view>
          </view>
          <text class="order-text">{{item.name}}</text>
        </view>
      </view>
    </view>

    <!-- 功能菜单 -->
    <view class="menu-section menu-{{menuLayoutType}}">
      <block wx:for="{{menuList}}" wx:key="name">
        <button wx:if="{{item.openType === 'contact'}}" class="menu-item" open-type="contact">
          <image class="menu-icon-img" mode="aspectFit" src="{{item.icon}}" style="transform: scale({{item.scale}})"></image>
          <text class="menu-name">{{item.name}}</text>
          <text class="menu-arrow" wx:if="{{menuLayoutType === 'list'}}">›</text>
        </button>
        <view wx:else class="menu-item" data-item="{{item}}" bindtap="onMenuTap">
          <image class="menu-icon-img" mode="aspectFit" src="{{item.icon}}" style="transform: scale({{item.scale}})"></image>
          <text class="menu-name">{{item.name}}</text>
          <text class="menu-arrow" wx:if="{{menuLayoutType === 'list'}}">›</text>
        </view>
      </block>
    </view>

    <!-- 退出登录（仅 mine_bottom 模式显示） -->
    <view class="logout-section" wx:if="{{userInfo.isLogin && logoutPosition === 'mine_bottom'}}">
      <view class="logout-btn" bindtap="handleLogout">
        <image class="logout-icon" src="/images/icons/logout.svg"></image>
        <text>退出登录</text>
      </view>
      <!-- F2: 注销账号入口 -->
      <view class="delete-account-link" bindtap="handleDeleteAccount">注销账号</view>
    </view>

  </view>
</scroll-view>
